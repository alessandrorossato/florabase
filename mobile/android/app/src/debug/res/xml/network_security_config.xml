<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds only: permit cleartext HTTP to local dev servers (e.g. 10.0.2.2 or private LAN);
         JS URL validation still restricts plain HTTP to 10.0.2.2 and private LAN hosts.
         Release builds use src/main/res/xml/network_security_config.xml (cleartextTrafficPermitted="false"). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
