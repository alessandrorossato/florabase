# Safe local-development values only. Replace every credential before deployment.
POSTGRES_DB=florabase
POSTGRES_USER=florabase
POSTGRES_PASSWORD=local-development-password
FLORABASE_DATABASE_URL=postgresql+psycopg://florabase:local-development-password@db:5432/florabase
FLORABASE_CANONICAL_ORIGIN=https://florabase.example.com
FLORABASE_CORS_ORIGINS=[]
FLORABASE_LOG_LEVEL=INFO
FLORABASE_LOG_FORMAT=json
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
LOCAL_UID=1000
LOCAL_GID=1000
