# Example configuration. make setup copies this file to the ignored .env file.
# Replace both matching database-password occurrences before any durable or public deployment.
POSTGRES_DB=florabase
POSTGRES_USER=florabase
POSTGRES_PASSWORD=local-development-password
FLORABASE_DATABASE_URL=postgresql+psycopg://florabase:local-development-password@db:5432/florabase
# Production requires exactly one HTTPS origin: scheme + authority, with no path, query, or fragment.
# compose.dev.yaml overrides this with the HTTP loopback origin http://localhost:5173.
FLORABASE_CANONICAL_ORIGIN=https://florabase.example.com
# Production is deliberately same-origin and rejects every non-empty CORS list.
FLORABASE_CORS_ORIGINS=[]
FLORABASE_LOG_LEVEL=INFO
FLORABASE_LOG_FORMAT=json
# Keep loopback when an HTTPS reverse proxy on this host forwards to the frontend.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# The following ports are published only by compose.dev.yaml.
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
# Development containers use these host IDs for bind-mounted source files.
LOCAL_UID=1000
LOCAL_GID=1000
