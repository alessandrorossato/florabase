# Sanitized template of the stack `.env` for deploy/beta/compose.yaml. Every value is a placeholder.
#
# Normally `florabasectl.py init/install` renders this file into <root>/stack/.env from the host's
# state/installation.json and the authorized release; you do not copy it. It documents every
# variable for review and for a manual install on any linux/amd64 Docker host (Engine >= 24.0,
# Compose >= 2.20). Keep the real file, secrets and data outside this repository: <root> is any
# operator-chosen directory, for example /srv/florabase or /volume1/docker/florabase.

# Release pair and database, all by immutable digest from the authorized release manifest.
FLORABASE_RELEASE_VERSION=0.1.0-beta.N
FLORABASE_BACKEND_IMAGE=ghcr.io/alessandrorossato/florabase-backend@sha256:<backend-index-digest>
FLORABASE_FRONTEND_IMAGE=ghcr.io/alessandrorossato/florabase-frontend@sha256:<frontend-index-digest>
FLORABASE_POSTGRES_IMAGE=docker.io/library/postgres:<version>@sha256:<postgresql-index-digest>

# Host paths (absolute; directories must already exist with the documented owners and modes).
# secrets/ holds db.env (POSTGRES_DB/USER/PASSWORD) and backend.env (FLORABASE_DATABASE_URL), 0600.
FLORABASE_SECRETS_DIR=/srv/florabase/secrets
FLORABASE_POSTGRES_DIR=/srv/florabase/postgres
FLORABASE_MEDIA_DIR=/srv/florabase/media
FLORABASE_REFERENCE_DIR=/srv/florabase/reference

# Exact public HTTPS origin users open (for example a Tailscale Serve name); no trailing slash.
FLORABASE_CANONICAL_ORIGIN=https://florabase.example.invalid
# Frontend listens only here; a host HTTPS proxy (such as Tailscale Serve) forwards to it.
FLORABASE_BIND_ADDRESS=127.0.0.1
FLORABASE_HTTP_PORT=8080
FLORABASE_LOG_LEVEL=INFO

# Resource ceilings (limits, not reservations). CPU 0 = unlimited; set CPUs only where
# `florabasectl.py preflight` reports CPU CFS quota support.
FLORABASE_DB_MEMORY=1g
FLORABASE_DB_CPUS=0
FLORABASE_BACKEND_MEMORY=768m
FLORABASE_BACKEND_CPUS=0
